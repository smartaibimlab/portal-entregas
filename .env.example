# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# NUNCA prefixe com NEXT_PUBLIC_. Usada apenas no servidor (rota /api/entrega/[id]).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# URL pública do site, sem barra no final (https). O Mercado Pago precisa
# alcançar /api/webhook — localhost NÃO funciona para notificações.
NEXT_PUBLIC_SITE_URL=https://seu-portal.vercel.app

# Mercado Pago > Suas integrações > (sua aplicação) > Credenciais de produção/teste
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# Opcional (recomendado): Suas integrações > Webhooks > "Assinatura secreta".
# Se definido, notificações com x-signature inválida são recusadas.
MERCADOPAGO_WEBHOOK_SECRET=
